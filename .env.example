# Node 24+, one persistent server; never commit real credentials.
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=./data/platform.sqlite
NODE_ENV=development
# Public frontend origin; production requires HTTPS.
APP_ORIGIN=http://127.0.0.1:3001
MANUAL_PAYMENTS=false
# Toss CARD checkout. Use your own test_sk_... first, then approved live_sk_...
PAYMENTS_ENABLED=false
TOSS_SECRET_KEY=
# Optional shared secret, SAME value on persistent server and Vercel.
# Enable this when the backend should be reachable only through the Vercel gateway.
BACKEND_GATEWAY_TOKEN=
# Vercel only: HTTPS origin of the persistent backend, not the Vercel frontend.
BACKEND_ORIGIN=
# One-time administrator creation only; no default or public registration.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
