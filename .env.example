# Node 24+, persistent single-instance server
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=./data/platform.sqlite
# Set production and https origin behind your HTTPS reverse proxy before public use.
NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:3001
# Actual online payment provider is NOT integrated. Manual receipts are off by default.
MANUAL_PAYMENTS=false
# Only needed for one-time create-admin, do not commit actual credentials:
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
